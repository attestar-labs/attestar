# Copy to .env.local and fill in the blanks (Next.js loads .env.local
# automatically). Never commit a real .env.local: it holds the issuer secret.

# --- Public configuration (inlined into the browser bundle) ---
NEXT_PUBLIC_ATTESTAR_ID=
NEXT_PUBLIC_TOKEN_ID=
NEXT_PUBLIC_RESERVE_HOLDER=
NEXT_PUBLIC_SINK_ADDRESS=
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
NEXT_PUBLIC_EXPLORER=https://stellar.expert/explorer/testnet
NEXT_PUBLIC_USDC_DECIMALS=7

# --- Server-side configuration (used by scripts/test_client.mjs) ---
# Stellar secret seed of the issuer key. Leave empty in the example.
ISSUER_SECRET=
# Attestar + token contract ids of the target deployment.
ATTESTAR_ID=
TOKEN_ID=
