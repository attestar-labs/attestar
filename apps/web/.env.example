# Copy to apps/web/.env.local and adjust. Every value below is optional: when a
# variable is unset the web app falls back to the committed testnet defaults in
# apps/web/lib/config.ts and apps/web/lib/format.ts.
#
# apps/web/.env.local is gitignored and also carries the issuer secret when it is
# written by packages/contracts/scripts/setup_web_demo.sh — never commit it.

# Attestar contract (testnet)
NEXT_PUBLIC_ATTESTAR_ID=CD36EVFKGZH23JLRQMJZPG7XKPNO6ZVK67GHN2RQJG5VM6CVYTE2GRDH

# Reserve asset: the real Circle USDC Stellar Asset Contract on testnet
NEXT_PUBLIC_TOKEN_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA

# Address the contract reads the on-chain reserve balance from
NEXT_PUBLIC_RESERVE_HOLDER=GDFKPIKJIY4JCYNMQ6IGX674O4HLPIPWD42LWHJSLOHAKR33IZ2VQTID

# Address that receives the drained USDC in the demo
NEXT_PUBLIC_SINK_ADDRESS=GD2ASCDOYWLJKUWN5KZW6WV5SARW3HKXPKBFX6Y3THDFFM4HXQXY7KKA

# Soroban RPC endpoint
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Block explorer base URL
NEXT_PUBLIC_EXPLORER=https://stellar.expert/explorer/testnet

# Decimal places used to render USDC base units
NEXT_PUBLIC_USDC_DECIMALS=7
# Copy to .env.local and fill in the blanks (Next.js loads .env.local
# automatically). Never commit a real .env.local: it holds the issuer secret.

# --- Public configuration (inlined into the browser bundle) ---
NEXT_PUBLIC_ATTESTAR_ID=
NEXT_PUBLIC_TOKEN_ID=
NEXT_PUBLIC_RESERVE_HOLDER=
NEXT_PUBLIC_SINK_ADDRESS=
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
NEXT_PUBLIC_EXPLORER=https://stellar.expert/explorer/testnet
NEXT_PUBLIC_USDC_DECIMALS=7

# --- Server-side configuration (used by scripts/test_client.mjs) ---
# Stellar secret seed of the issuer key. Leave empty in the example.
ISSUER_SECRET=
# Attestar + token contract ids of the target deployment.
ATTESTAR_ID=
TOKEN_ID=
